{{- $pages := where site.RegularPages "Section" "r" -}}
[
{{- range $i, $p := $pages -}}
{{- if $i }},{{ end -}}
{"title": {{ $p.Title | jsonify }},
 "url": {{ $p.RelPermalink | jsonify }},
 "desc": {{ $p.Description | jsonify }},
 "authors": {{ $p.Params.author | default (slice) | jsonify }},
 "categories": {{ $p.Params.categories | default (slice) | jsonify }}}
{{- end -}}
]
